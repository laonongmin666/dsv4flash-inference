+            raise ValueError("Gate token counts are invalid")
+        threshold = int(os.environ.get("V4FLASH_AR_DUAL_MIN_TOKENS", "4096"))
+        route = ROUTES[int(bool(actual))]
+        self.counters["total_steps"] += 1
+        self.counters["total_tokens"] += num_tokens
+        self.counters["eligible_steps"] += int(num_tokens >= threshold)
+        self.counters["requested_splits"] += int(bool(requested))
+        self.counters["actual_splits"] += int(bool(actual))
+        self.counters["split_tokens"] += num_tokens if actual else 0
+        self.counters["fallback_steps"] += int(bool(requested) and not actual)
+        self.counters["single_steps"] += int(not actual)
+        self.route_counts[route] += 1
