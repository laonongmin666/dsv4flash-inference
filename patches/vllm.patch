+            id=i,
+            compute_stream=lane_streams[i],
+            forward_context=forward_contexts[i],
+            ready_barrier=ready_barrier,
+            lane=i,
+            parent_stream=compute_stream,
+        )
+        for i in range(num_micro_batches)
+    ]
