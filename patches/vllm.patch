+def compatible_topology(config):
+    """Fail closed: this extension keeps the DP handshake and EP disabled."""
+    return (
+        config is not None
+        and config.tensor_parallel_size == 1
+        and config.data_parallel_size == 4
+        and config.decode_context_parallel_size == 1
+        and config.prefill_context_parallel_size == 1
+        and config.pipeline_parallel_size == 1
+        and not config.enable_expert_parallel
+        and not config.use_ubatching
+    )
+
+
+def dp4_r6_thresholds(config, num_tokens, uniform_decode, fallback):
+    """Replace only the threshold decision inside the existing DP agreement."""
+    if os.environ.get("V4FLASH_DP4_R6_ENABLE", "0") != "1":
+        return fallback(config, num_tokens, uniform_decode=uniform_decode)
+    if not compatible_topology(config):
+        raise ValueError("DP4 R6 requires TP1/DP4/DCP1/PCP1/PP1, EP=0 and DBO off")
+    if os.environ.get("V4FLASH_AR_DUAL", "0") != "1":
+        return fallback(config, num_tokens, uniform_decode=uniform_decode)
+    if os.environ.get("V4FLASH_AR_DUAL_PURE_PREFILL", "0") != "0":
+        raise ValueError("DP4 R6 supports the original R6 gate, not R6a")
+    threshold = int(os.environ.get("V4FLASH_AR_DUAL_MIN_TOKENS", "4096"))
+    if threshold < 256:
+        raise ValueError("DP4 R6 threshold must permit two 128-token aligned slices")
+    return num_tokens >= threshold
+
