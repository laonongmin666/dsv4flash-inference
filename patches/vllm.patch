+        self.identity = _process_identity()
+        self.dp_rank = dp_rank
+        self.counters = dict.fromkeys(COUNTERS, 0)
+        self.route_counts = dict.fromkeys(ROUTES, 0)
+        self.num_tokens_histogram = {}
+        self.padded_tokens_histogram = {}
+        self.last_step = None
