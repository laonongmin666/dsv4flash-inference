+        signal.signal(signal.SIGUSR2, lambda *_: _PROBE.flush("SIGUSR2"))
+        atexit.register(_PROBE.flush, "atexit")
+        _PROBE.flush("registered")
+    if _PROBE.dp_rank != dp_rank:
+        raise RuntimeError("A gate process cannot change its DP rank")
+    _PROBE.record(num_tokens, padded_tokens, requested, actual)
+
+
+def record_completed_split(dp_rank, num_tokens):
+    if not os.environ.get("V4FLASH_DP4_R6_PROBE_DIR"):
+        return
+    if _PROBE is None or _PROBE.dp_rank != dp_rank:
+        raise RuntimeError("Split completion has no matching rank gate")
+    _PROBE.completed(num_tokens)
