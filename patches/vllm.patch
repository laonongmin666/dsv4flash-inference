+    def completed(self, num_tokens):
+        if self.last_step is None or not self.last_step["actual_split"]:
+            raise RuntimeError("Cannot complete a split that was not dispatched")
+        if self.last_step["num_tokens"] != num_tokens:
+            raise RuntimeError("Completed split uses a different scheduler token count")
+        self.counters["completed_splits"] += 1
+        self.counters["completed_split_tokens"] += num_tokens
