+            schema="dp4-r6-gate-v1", **self.identity,
+            dp_rank=self.dp_rank, time_ns=time.time_ns(), reason=reason,
+            counters=dict(self.counters), route_counts=dict(self.route_counts),
+            num_tokens_histogram=dict(self.num_tokens_histogram),
+            padded_tokens_histogram=dict(self.padded_tokens_histogram),
+            last_step=self.last_step,
+            dual=os.environ.get("V4FLASH_AR_DUAL", "0"),
+            extension=os.environ.get("V4FLASH_DP4_R6_ENABLE", "0"),
+            min_tokens=int(os.environ.get("V4FLASH_AR_DUAL_MIN_TOKENS", "4096")),
+            decision="existing DP handshake; every rank allows; minimum rank meets threshold",
+        )
+        with self.path.open("a", encoding="utf-8") as stream:
+            stream.write(json.dumps(record, sort_keys=True) + "\n")
