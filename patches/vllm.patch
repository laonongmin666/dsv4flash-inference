+"""Budgeted eviction preference for verified local Full/SWA checkpoints.
+
+Copied into a private vLLM overlay by the builder. This module never mutates
+KV references, hashes, returned computed blocks, or the total free capacity.
+"""
+from __future__ import annotations
+
+from collections import Counter, OrderedDict
+import json
+import os
+import time
+
+
+class SoftCheckpointQueue:
+    """Two original intrusive queues; ordinary victims precede protected ones."""
+
+    def __init__(self, ordinary, state):
+        self.ordinary = ordinary
+        self.protected = type(ordinary)([])
+        self.state = state
+        self.protected_ids = set()
+
+    @property
+    def num_free_blocks(self):
+        return self.ordinary.num_free_blocks + self.protected.num_free_blocks
+
+    def _queue(self, block):
+        return self.protected if block.block_id in self.protected_ids else self.ordinary
+
+    def remove(self, block):
+        self._queue(block).remove(block)
+        self.protected_ids.discard(block.block_id)
+
+    def popleft(self):
+        return self.popleft_n(1)[0]
+
+    def popleft_n(self, count):
+        assert count <= self.num_free_blocks
+        ordinary_count = min(count, self.ordinary.num_free_blocks)
+        result = self.ordinary.popleft_n(ordinary_count)
+        fallback = self.protected.popleft_n(count - ordinary_count)
+        self.state.metrics["protected_victims"] += len(fallback)
+        for block in fallback:
+            self.protected_ids.remove(block.block_id)
+        return result + fallback
+
+    def append(self, block):
+        self.append_n([block])
+
+    def append_n(self, blocks):
+        ordinary, protected = [], []
+        for block in blocks:
